{#
| PhoneX — Newsletter Section
| Uses Salla newsletter component if available
#}
<section id="newsletter" class="phonenx-newsletter" aria-label="{{ trans('common.elements.newsletter')|default('النشرة البريدية') }}">
    <div class="container">
        <div class="newsletter-card charge">

            <div class="newsletter-content">
                <h2 class="newsletter-title serif">
                    {{ theme.settings.get('phonenx_newsletter_title')|default('خصم 5% على أول طلب') }}
                </h2>
                <p class="newsletter-desc">
                    {{ theme.settings.get('phonenx_newsletter_desc')|default('اشترك ليصلك كل جديد — إصدارات، عروض حصرية، وأكواد خصم قبل الجميع.') }}
                </p>
            </div>

            {# Salla newsletter form #}
            <salla-newsletter-form
                data-testid="store-newsletter"
                class="newsletter-form"
                placeholder="{{ trans('common.elements.email')|default('البريد الإلكتروني') }}"
                submit-text="{{ trans('common.elements.subscribe')|default('اشترك') }}">
            </salla-newsletter-form>
        </div>
    </div>
</section>
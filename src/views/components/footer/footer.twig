{# ============ PhoneX Footer ============ #}
<footer data-testid="store-footer" class="px-footer">
    <div class="container px-footer__grid">

        <div class="px-footer__about">
            <a href="{{ link('/') }}" class="px-logo px-footer__logo">
                <span class="px-logo__text">Phone<b>X</b></span>
            </a>
            {% if store.description %}
                <div class="px-footer__desc">{{ store.description|raw }}</div>
            {% endif %}
            <salla-social data-testid="store-footer-social" class="px-footer__social"></salla-social>
        </div>

        <div class="px-footer__col">
            <h3 class="px-footer__title">{{ trans('phonex.footer.store_links') }}</h3>
            <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
        </div>

        <div class="px-footer__col">
            <h3 class="px-footer__title">{{ trans('phonex.footer.contact') }}</h3>
            <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
        </div>

        <div class="px-footer__col px-footer__col--apps">
            <salla-trust-badges data-testid="store-footer-trust-badges" dark></salla-trust-badges>
            <salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
        </div>
    </div>

    {% if theme.settings.get('show_tax_number', true) and store.settings.tax.number %}
    <div class="container px-footer__tax">
        {% if store.settings.tax.certificate %}
            <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" aria-label="{{ store.settings.tax.number }}">
                <img width="36" height="45" src="{{ 'images/tax.png' | cdn(70,70) }}" loading="lazy" alt="ضريبة القيمة المضافة">
            </a>
        {% endif %}
        <div>
            <p class="px-footer__tax-label">{{ trans('phonex.footer.tax_number') }}</p>
            <b>{{ store.settings.tax.number }}</b>
        </div>
        {% if store.settings.tax.certificate %}
            <salla-modal data-testid="store-footer-tax-modal" sub-title-first
                        sub-title="{{ trans('phonex.footer.tax_number') }}"
                        modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                <div class="flex justify-center max-w-full">
                    <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
                </div>
            </salla-modal>
        {% endif %}
    </div>
    {% endif %}

    <div class="container px-footer__bottom">
        <span class="px-footer__copyright">{% hook copyright %}</span>
        <salla-payments data-testid="store-footer-payments"></salla-payments>
    </div>
</footer>

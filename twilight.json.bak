{
    "name": {
        "ar": "فونكس",
        "en": "PhoneX"
    },
    "repository": "https://github.com/your-username/theme-phonex",
    "author_email": "support@phonex.store",
    "support_url": "https://phonex.store/support",
    "description": {
        "ar": "قالب داكن فاخر متخصص في متاجر الجوالات والإكسسوارات — عدّ تنازلي للعروض، شريط ماركات متحرك، وتجربة تسوق سريعة",
        "en": "Premium dark theme built for mobile & accessories stores — deals countdown, brands marquee, and a fast shopping experience"
    },
    "features": [
        "fonts",
        "color",
        "mega-menu",
        "breadcrumb",
        "menu-images",
        "filters",
        "unite-cards-height",
        "component-featured-products",
        "component-fixed-banner",
        "component-fixed-products",
        "component-products-slider",
        "component-photos-slider",
        "component-parallax-background",
        "component-testimonials",
        "component-square-photos",
        "component-store-features",
        "component-youtube"
    ],
    "settings": [
        { "type": "string", "id": "placeholder", "format": "hidden", "value": "images/placeholder.png" },
        { "type": "boolean", "icon": "sicon-toggle-off", "label": "تثبيت الشريط العلوي عند التمرير", "description": "يبقى شريط التنقل ظاهراً أثناء تمرير الصفحة", "id": "sticky_header", "format": "switch", "required": false, "value": true, "selected": true },
        { "type": "boolean", "icon": "sicon-toggle-off", "label": "إظهار شريط التنقل السفلي للجوال", "description": "شريط تنقل ثابت أسفل الشاشة لأجهزة الجوال", "id": "show_bottom_nav", "format": "switch", "required": false, "value": true, "selected": true },
        { "type": "boolean", "icon": "sicon-toggle-off", "label": "تفعيل خط العرض اللاتيني (DM Serif Display)", "description": "يُستخدم للأرقام والعناوين اللاتينية فقط", "id": "display_font_enabled", "format": "switch", "required": false, "value": true, "selected": true },
        { "type": "boolean", "icon": "sicon-toggle-off", "label": "تفعيل إشعار الإضافة للسلة", "description": "إشعار أنيق يظهر عند إضافة منتج للسلة", "id": "enable_add_product_toast", "format": "switch", "required": false, "value": true, "selected": true },
        { "type": "boolean", "icon": "sicon-toggle-off", "label": "إظهار الرقم الضريبي في الفوتر", "description": null, "id": "show_tax_number", "format": "switch", "required": false, "value": true, "selected": true },
        { "type": "static", "id": "static-line-1", "format": "line" },
        { "type": "boolean", "icon": "sicon-toggle-off", "label": "تكبير صور المنتجات عند المرور عليها", "description": "تأثير Zoom خفيف في بطاقات المنتجات", "id": "product_card_zoom", "format": "switch", "required": false, "value": true, "selected": true }
    ],
    "components": [
        {
            "key": "a1f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c01",
            "title": { "en": "PhoneX Hero", "ar": "الواجهة الرئيسية (هيرو)" },
            "icon": "sicon-home-wave",
            "path": "home.phonex-hero",
            "is_default": true,
            "fields": [
                { "type": "string", "icon": "sicon-tag", "label": "نص الشارة العلوية", "id": "badge", "format": "text", "required": false, "multilanguage": true, "value": "أحدث الإصدارات — 2025", "maxLength": 80 },
                { "type": "string", "icon": "sicon-format-text-alt", "label": "العنوان الرئيسي", "id": "title", "format": "text", "required": true, "multilanguage": true, "value": "اكتشف عالم الجوالات الذكية — بتجربة مختلفة", "maxLength": 120 },
                { "type": "string", "icon": "sicon-typography", "label": "الوصف", "id": "description", "format": "textarea", "required": false, "multilanguage": true, "value": "تشكيلة ضخمة من أحدث الأجهزة والإكسسوارات بأسعار تنافسية، توصيل سريع لكل مكان، وضمان رسمي على جميع المنتجات.", "maxLength": 300 },
                {
                    "id": "slides", "type": "collection", "format": "collection", "required": true, "minLength": 1, "maxLength": 6, "item_label": "جهاز",
                    "fields": [
                        { "type": "string", "icon": "sicon-image", "label": "صورة الجهاز", "id": "slides.image", "format": "image", "required": true, "description": "* المقاس المناسب 800×800 بكسل بخلفية شفافة" },
                        { "type": "string", "icon": "sicon-format-text-alt", "label": "اسم الجهاز", "id": "slides.name", "format": "text", "required": true, "multilanguage": true, "maxLength": 80 },
                        { "type": "string", "icon": "sicon-tag", "label": "شارة (مثال: الأكثر طلباً)", "id": "slides.badge", "format": "text", "required": false, "multilanguage": true, "maxLength": 40 },
                        { "type": "string", "icon": "sicon-wallet", "label": "السعر", "id": "slides.price", "format": "text", "required": false, "maxLength": 30 },
                        { "type": "string", "icon": "sicon-wallet-minus", "label": "السعر قبل الخصم", "id": "slides.old_price", "format": "text", "required": false, "maxLength": 30 },
                        { "type": "string", "icon": "sicon-list", "label": "المزايا (افصل بينها بـ |)", "id": "slides.chips", "format": "text", "required": false, "value": "شريحة A18 Pro | كاميرا 48MP | تيتانيوم درجة 5", "maxLength": 200 },
                        { "type": "items", "icon": "sicon-link", "label": "رابط الجهاز", "id": "slides.url", "format": "variable-list", "searchable": true, "required": false, "source": "custom",
                            "sources": [
                                { "label": "منتج", "key": "products", "value": "products" },
                                { "label": "تصنيف", "key": "categories", "value": "categories" },
                                { "label": "التخفيضات", "key": "offers_link", "value": "offers_link" },
                                { "label": "رابط خارجي", "key": "custom", "value": "custom" }
                            ]
                        }
                    ]
                },
                {
                    "id": "stats", "type": "collection", "format": "collection", "required": false, "minLength": 1, "maxLength": 4, "item_label": "إحصائية",
                    "fields": [
                        { "type": "string", "icon": "sicon-numbered-list", "label": "القيمة (مثال: 60K+)", "id": "stats.value", "format": "text", "required": true, "maxLength": 20 },
                        { "type": "string", "icon": "sicon-format-text-alt", "label": "الوصف", "id": "stats.label", "format": "text", "required": true, "multilanguage": true, "maxLength": 40 }
                    ]
                }
            ]
        },
        {
            "key": "b2f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c02",
            "title": { "en": "PhoneX Brands Marquee", "ar": "شريط الماركات المتحرك" },
            "icon": "sicon-award-ribbon",
            "path": "home.phonex-brands",
            "is_default": true,
            "fields": [
                { "type": "items", "icon": "sicon-keyboard_arrow_down", "label": "الماركات التجارية", "id": "brands", "format": "dropdown-list", "selected": [], "options": [], "required": true, "multichoice": true, "searchable": true, "source": "brands" }
            ]
        },
        {
            "key": "c3f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c03",
            "title": { "en": "PhoneX Category Tiles", "ar": "تصنيفات (تايلز مرقّمة)" },
            "icon": "sicon-layout-grid-rearrange",
            "path": "home.phonex-categories",
            "is_default": true,
            "fields": [
                { "type": "string", "icon": "sicon-format-text-alt", "label": "عنوان القسم", "id": "title", "format": "text", "required": false, "multilanguage": true, "value": "تصفّح حسب الفئة", "maxLength": 80 },
                {
                    "id": "tiles", "type": "collection", "format": "collection", "required": true, "minLength": 2, "maxLength": 6, "item_label": "تصنيف",
                    "fields": [
                        { "type": "string", "icon": "sicon-text-field", "label": "كلمة لاتينية صغيرة (مثال: FLAGSHIP)", "id": "tiles.tag", "format": "text", "required": false, "maxLength": 20 },
                        { "type": "string", "icon": "sicon-format-text-alt", "label": "العنوان", "id": "tiles.title", "format": "text", "required": true, "multilanguage": true, "maxLength": 60 },
                        { "type": "string", "icon": "sicon-typography", "label": "الوصف", "id": "tiles.description", "format": "textarea", "required": false, "multilanguage": true, "maxLength": 160 },
                        { "type": "string", "icon": "sicon-image", "label": "الصورة", "id": "tiles.image", "format": "image", "required": true, "description": "* المقاس المناسب 640×480 بكسل" },
                        { "type": "items", "icon": "sicon-link", "label": "الرابط", "id": "tiles.url", "format": "variable-list", "searchable": true, "required": false, "source": "custom",
                            "sources": [
                                { "label": "منتج", "key": "products", "value": "products" },
                                { "label": "منتجات مع وسم", "key": "products_tags", "value": "products_tags" },
                                { "label": "تصنيف", "key": "categories", "value": "categories" },
                                { "label": "ماركة تجارية", "key": "brands", "value": "brands" },
                                { "label": "التخفيضات", "key": "offers_link", "value": "offers_link" },
                                { "label": "رابط خارجي", "key": "custom", "value": "custom" }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "key": "d4f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c04",
            "title": { "en": "PhoneX Featured Products", "ar": "أجهزة مميزة (تبويبات)" },
            "icon": "sicon-mobile-touch",
            "path": "home.phonex-products",
            "is_default": true,
            "fields": [
                { "type": "string", "icon": "sicon-format-text-alt", "label": "عنوان القسم", "id": "title", "format": "text", "required": false, "multilanguage": true, "value": "أكثر المنتجات طلباً", "maxLength": 80 },
                { "type": "string", "icon": "sicon-typography", "label": "وصف قصير", "id": "subtitle", "format": "text", "required": false, "multilanguage": true, "maxLength": 120 },
                { "type": "items", "icon": "sicon-keyboard_arrow_down", "label": "المنتجات", "id": "products", "format": "dropdown-list", "selected": [], "options": [], "required": true, "multichoice": true, "searchable": true, "source": "products", "minLength": 4, "maxLength": 16 },
                { "type": "items", "icon": "sicon-link", "label": "رابط (عرض جميع المنتجات)", "id": "display_all_url", "format": "variable-list", "searchable": true, "required": false, "source": "custom",
                    "sources": [
                        { "label": "تصنيف", "key": "categories", "value": "categories" },
                        { "label": "التخفيضات", "key": "offers_link", "value": "offers_link" },
                        { "label": "رابط خارجي", "key": "custom", "value": "custom" }
                    ]
                }
            ]
        },
        {
            "key": "e5f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c05",
            "title": { "en": "PhoneX Deal Countdown", "ar": "عرض اليوم (عدّاد تنازلي)" },
            "icon": "sicon-fire",
            "path": "home.phonex-deal",
            "is_default": true,
            "fields": [
                { "type": "string", "icon": "sicon-format-text-alt", "label": "العنوان", "id": "title", "format": "text", "required": false, "multilanguage": true, "value": "لا تفوّت هذا السعر", "maxLength": 80 },
                { "type": "string", "icon": "sicon-typography", "label": "وصف قصير", "id": "subtitle", "format": "text", "required": false, "multilanguage": true, "value": "عرض محدود الوقت — اليوم الواحد", "maxLength": 120 },
                { "type": "items", "icon": "sicon-mobile-touch", "label": "منتج العرض", "id": "product", "format": "dropdown-list", "selected": [], "options": [], "required": true, "searchable": true, "source": "products" },
                { "type": "string", "icon": "sicon-calendar-date", "label": "نهاية العرض", "id": "ends_at", "format": "text", "required": true, "description": "بصيغة: 2025-12-31 23:59:59", "placeholder": "2025-12-31 23:59:59" },
                { "type": "string", "icon": "sicon-wallet-minus", "label": "نص التوفير (مثال: وفّر 1,100 ر.س)", "id": "saved_text", "format": "text", "required": false, "multilanguage": true, "maxLength": 60 },
                { "type": "string", "icon": "sicon-packed-box", "label": "نص المخزون (مثال: نفد 82% من الكمية)", "id": "stock_text", "format": "text", "required": false, "multilanguage": true, "maxLength": 80 },
                { "type": "number", "icon": "sicon-progress-bar", "label": "نسبة نفاد الكمية %", "id": "stock_percent", "format": "integer", "required": false, "minimum": 0, "maximum": 100, "value": 82 }
            ]
        },
        {
            "key": "f6f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c06",
            "title": { "en": "PhoneX Trust Features", "ar": "لماذا PhoneX؟ (مزايا الثقة)" },
            "icon": "sicon-shield-check",
            "path": "home.phonex-trust",
            "is_default": true,
            "fields": [
                { "type": "string", "icon": "sicon-format-text-alt", "label": "العنوان", "id": "title", "format": "text", "required": false, "multilanguage": true, "value": "تجربة تُصنع بثقة", "maxLength": 80 },
                {
                    "id": "features", "type": "collection", "format": "collection", "required": true, "minLength": 2, "maxLength": 6, "item_label": "ميزة",
                    "fields": [
                        { "type": "string", "icon": "sicon-smile", "label": "الأيقونة", "id": "features.icon", "format": "icon", "required": false, "value": "sicon-store2" },
                        { "type": "string", "icon": "sicon-format-text-alt", "label": "العنوان", "id": "features.title", "format": "text", "required": true, "multilanguage": true, "maxLength": 60 },
                        { "type": "string", "icon": "sicon-typography", "label": "الوصف", "id": "features.description", "format": "textarea", "required": false, "multilanguage": true, "maxLength": 160 }
                    ]
                }
            ]
        },
        {
            "key": "07f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c07",
            "title": { "en": "PhoneX Reviews", "ar": "آراء العملاء (مخصصة)" },
            "icon": "sicon-chat-bubbles",
            "path": "home.phonex-reviews",
            "is_default": true,
            "fields": [
                { "type": "string", "icon": "sicon-format-text-alt", "label": "العنوان", "id": "title", "format": "text", "required": false, "multilanguage": true, "value": "ماذا يقولون عنّا", "maxLength": 80 },
                { "type": "string", "icon": "sicon-star", "label": "ملخص التقييم (مثال: 4.9 من 12,400+ تقييم موثّق)", "id": "summary", "format": "text", "required": false, "multilanguage": true, "maxLength": 100 },
                {
                    "id": "items", "type": "collection", "format": "collection", "required": true, "minLength": 1, "maxLength": 12, "item_label": "رأي",
                    "fields": [
                        { "type": "string", "icon": "sicon-format-text-alt", "label": "اسم العميل", "id": "items.name", "format": "text", "required": true, "maxLength": 60 },
                        { "type": "string", "icon": "sicon-image", "label": "الصورة الرمزية", "id": "items.avatar", "format": "image", "required": false, "description": "المقاس المناسب 96×96 بكسل" },
                        { "type": "number", "icon": "sicon-star", "label": "عدد النجوم", "id": "items.stars", "format": "integer", "required": false, "minimum": 1, "maximum": 5, "value": 5 },
                        { "type": "string", "icon": "sicon-typography", "label": "نص الرأي", "id": "items.text", "format": "textarea", "required": true, "multilanguage": true, "maxLength": 300 },
                        { "type": "string", "icon": "sicon-location", "label": "المدينة وماذا اشترى", "id": "items.meta", "format": "text", "required": false, "multilanguage": true, "value": "الرياض — اشترى iPhone 16 Pro", "maxLength": 80 }
                    ]
                }
            ]
        },
        {
            "key": "18f0c8d2-3b4e-4f6a-9c1d-0e1f2a3b4c08",
            "title": { "en": "PhoneX Newsletter", "ar": "النشرة البريدية" },
            "icon": "sicon-email",
            "path": "home.phonex-newsletter",
            "is_default": true,
            "fields": [
                { "type": "string", "icon": "sicon-tag", "label": "شارة (مثال: خصم 5% على أول طلب)", "id": "badge", "format": "text", "required": false, "multilanguage": true, "maxLength": 60 },
                { "type": "string", "icon": "sicon-format-text-alt", "label": "العنوان", "id": "title", "format": "text", "required": false, "multilanguage": true, "value": "اشترك ليصلك كل جديد", "maxLength": 100 },
                { "type": "string", "icon": "sicon-typography", "label": "الوصف", "id": "description", "format": "textarea", "required": false, "multilanguage": true, "value": "إصدارات، عروض حصرية، وأكواد خصم قبل الجميع.", "maxLength": 200 },
                { "type": "string", "icon": "sicon-send", "label": "نص الزر", "id": "button_label", "format": "text", "required": false, "multilanguage": true, "value": "اشترك", "maxLength": 30 }
            ]
        }
    ]
}

<footer data-testid="store-footer" class="store-footer phonenx-footer" id="contact">
    <div aria-label="footer" class="store-footer__inner">
        <div class="container">

            {# ===== Top grid ===== #}
            <div class="footer-grid">

                {# Brand + description + social #}
                <div class="footer-brand-col">
                    <a href="{{ link('/') }}" class="footer-brand" aria-label="{{ store.name }}">
                        {% if store.logo %}
                            <img src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo" loading="lazy">
                        {% else %}
                            <span class="brand-text">{{ store.name }}</span>
                        {% endif %}
                    </a>

                    {% if store.description %}
                        <div class="footer-desc">
                            {{ store.description|raw }}
                        </div>
                    {% endif %}

                    <salla-social data-testid="store-footer-social" class="footer-social"></salla-social>
                </div>

                {# Store pages menu (Salla official) #}
                <div class="footer-menu-col">
                    <h3 class="footer-col-title">{{ trans('blocks.footer.pages_links')|default('المتجر') }}</h3>
                    <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
                </div>

                {# Contact info (Salla official) #}
                <div class="footer-contact-col">
                    <h3 class="footer-col-title">{{ trans('common.elements.contact_us')|default('تواصل معنا') }}</h3>
                    <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
                </div>

                {# Apps icons (Salla official) #}
                <div class="footer-apps-col">
                    <salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
                </div>
            </div>

            {# ===== Trust badges + VAT (theme-raed original) ===== #}
            <div class="footer-trust-row">
                <salla-trust-badges data-testid="store-footer-trust-badges"
                    {% if theme.settings.get('footer_is_dark') %} dark {% endif %}>
                </salla-trust-badges>

                {% if store.settings.tax.number %}
                    <div class="footer-vat">
                        {% if store.settings.tax.certificate %}
                            <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                                <img width="40" height="50" src="{{ 'images/tax.png'|cdn(70,70) }}" loading="lazy" alt="{{ trans('common.elements.tax_number')|default('الرقم الضريبي') }}">
                            </a>
                        {% endif %}
                        <div>
                            <p class="footer-vat-label">{{ trans('common.elements.tax_number')|default('الرقم الضريبي') }}</p>
                            <b>{{ store.settings.tax.number }}</b>
                        </div>
                    </div>

                    {% if store.settings.tax.certificate %}
                        <salla-modal data-testid="store-footer-tax-modal"
                                    sub-title-first
                                    sub-title="{{ trans('common.elements.tax_number')|default('الرقم الضريبي') }}"
                                    modal-title="{{ store.settings.tax.number }}"
                                    id="modal-value-tax">
                            <div class="flex justify-center max-w-full">
                                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
                            </div>
                        </salla-modal>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    {# ===== Bottom bar: copyright + payments ===== #}
    <div class="footer-bottom container">
        <span class="copyright-text">{% hook copyright %}</span>
        <salla-payments data-testid="store-footer-payments"></salla-payments>
    </div>
</footer>

<span class="hidden">{% hook footer %}</span>
{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description
|----------------------------------------------------|----------|------------------------------------
| store                                              | Store    |
| store.id                                           | int      |
| store.name                                         | string   |
| store.username                                     | string   |
| store.description                                  | string   |
| store.slogan                                       | ?string  | * if feature in twilight.json
| store.logo                                         | string   |
| store.url                                          | string   |
| store.api                                          | string   | the api url for current store
| store.icon                                         | string   | *fav icon url
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram]
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, ...]
| store.settings                                     | object   |
| cart                                               | object   |
| cart.items_count                                   | int      |
| cart.total                                         | string   | Formatted total ex: "١٠٠ ر.س"
| user                                               | ?User    | null if guest
| page                                               | object   | current page info
| theme                                              | object   | theme settings access
#}
<!doctype html>
<html lang="{{ store.settings.language|default('ar') }}"
      dir="{{ store.settings.direction|default('rtl') }}"
      class="{% if theme.settings.get('phonenx_dark_mode_default') %}dark{% endif %}">
<head>
    <meta charset="utf-8">
    {% hook 'head:start' %}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#050507">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">

    <title>{{ page.title|default(store.name) }}</title>

    {# PhoneX — preconnect for CDN fonts #}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

    {# ===== PhoneX CSS ===== #}
    <link rel="stylesheet" href="{{ 'app.css'|asset }}">
    {% block styles %}{% endblock %}

    {% hook 'head:end' %}
</head>

<body class="phonenx-body {% if is_page('index') %}page-home{% endif %}">
    {% hook 'body:start' %}

    {# ===== PhoneX signature layers ===== #}
    {% if theme.settings.get('phonenx_progress_bar') %}
        <div class="progress" id="phonenx-progress" aria-hidden="true"></div>
    {% endif %}

    {% if theme.settings.get('phonenx_noise_overlay') %}
        <div class="noise" aria-hidden="true"></div>
    {% endif %}

    {# ===== Store Header (theme-raed component) ===== #}
    {% component 'header.header' %}

    {# ===== Page Content ===== #}
    <main id="main-content" class="phonenx-main">
        {% block content %}{% endblock %}
    </main>

    {# ===== Store Footer (theme-raed component) ===== #}
    {% component 'footer.footer' %}

    {# ===== PhoneX Mobile Bottom Nav ===== #}
    {% component 'home.phonenx-mobile-nav' %}

    {# ===== Salla global web components (theme-raed originals — do NOT remove) ===== #}
    <salla-offer-modal></salla-offer-modal>
    <salla-search></salla-search>
    <salla-login-modal></salla-login-modal>
    <salla-scopes></salla-scopes>
    <salla-add-product-toast></salla-add-product-toast>

    {# ===== PhoneX JS ===== #}
    <script defer src="{{ 'app.js'|asset }}"></script>
    {% block scripts %}{% endblock %}

    {% hook 'body:end' %}
</body>
</html>

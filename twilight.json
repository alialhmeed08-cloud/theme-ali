    { "type": "boolean", "icon": "sicon-toggle-off", "label": "إظهار شريط التقدم", "id": "phonenx_progress_bar", "format": "switch", "value": true, "selected": true },
    { "type": "boolean", "icon": "sicon-image", "label": "إظهار طبقة الضجيج", "id": "phonenx_noise_overlay", "format": "switch", "value": true, "selected": true },
    { "type": "boolean", "icon": "sicon-clock", "label": "تفعيل عدّاد عرض اليوم", "id": "phonenx_deal_countdown", "format": "switch", "value": true, "selected": true },
    { "type": "boolean", "icon": "sicon-pin", "label": "تثبيت الهيدر عند التمرير", "id": "header_is_sticky", "format": "switch", "value": true, "selected": true }

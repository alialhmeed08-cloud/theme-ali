    { "id": "deal", "title": { "ar": "عرض اليوم", "en": "Deal of the Day" }, "path": "components/home/phonex-deal.twig" },
    { "id": "trust", "title": { "ar": "لماذا نحن", "en": "Why Us" }, "path": "components/home/phonex-trust.twig" },
    { "id": "reviews", "title": { "ar": "آراء العملاء", "en": "Reviews" }, "path": "components/home/phonex-reviews.twig" },
    { "id": "newsletter", "title": { "ar": "النشرة البريدية", "en": "Newsletter" }, "path": "components/home/phonex-newsletter.twig" },
    { "id": "brands", "title": { "ar": "العلامات التجارية", "en": "Brands" }, "path": "components/home/phonex-brands.twig" },
